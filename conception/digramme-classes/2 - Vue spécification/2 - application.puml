@startuml
title "Couche Application - Bibliothèque Numérique (Use Cases & DTOs)"

package "Application" {

  package "Lecteur" {
    package "DTO" {
      class EmprunterLivreDto {
        + lecteurId
        + livreId
      }
      class RetournerLivreDto {
        + empruntId
      }
    }
    package "UseCase" {
      class ConsulterCatalogueUseCase {
        + execute(): List<Livre>
      }
      class RechercherLivreUseCase {
        + execute(keyword): List<Livre>
      }
      class EmprunterLivreUseCase {
        + execute(dto: EmprunterLivreDto): Emprunt
      }
      class RetournerLivreUseCase {
        + execute(dto: RetournerLivreDto): void
      }
      class VoirMesEmpruntsUseCase {
        + execute(lecteurId): List<Emprunt>
      }
      class VerifierDisponibiliteUseCase {
        + execute(livreId): bool
      }
    }
  }

  package "Bibliothecaire" {
    package "DTO" {
      class AjouterLivreDto {
        + titre
        + auteur
        + isbn
        + datePublication
        + nombreExemplaires
      }
      class ModifierLivreDto {
        + titre?
        + auteur?
        + isbn?
        + datePublication?
      }
      class EnregistrerEmpruntDto {
        + lecteurId
        + exemplaireId
      }
    }
    package "UseCase" {
      class AjouterLivreUseCase {
        + execute(dto: AjouterLivreDto): Livre
      }
      class ModifierLivreUseCase {
        + execute(livreId, dto): void
      }
      class SupprimerLivreUseCase {
        + execute(livreId): void
      }
      class EnregistrerEmpruntUseCase {
        + execute(dto: EnregistrerEmpruntDto): Emprunt
      }
      class EnregistrerRetourUseCase {
        + execute(empruntId): void
      }
      class ConsulterTousEmpruntsUseCase {
        + execute(): List<Emprunt>
      }
    }
  }
}
@enduml