@startuml
title "Implémentation - Domaine (PHP/Laravel) - Bibliothèque Numérique"

' Domaine principal des livres
namespace App\Domain\Livre {
  class Livre {
    - string $id
    - string $titre
    - string $auteur
    - string $isbn
    - DateTime $datePublication
    + __construct(string $titre, string $auteur, string $isbn, DateTime $datePublication)
    + getId(): string
    + getTitre(): string
    + getAuteur(): string
    + getIsbn(): string
    + getDatePublication(): DateTime
    + setTitre(string $titre): void
    + setAuteur(string $auteur): void
  }
  ' Interface de persistence pour Livre
  interface LivreRepositoryInterface {
    + findById(string $id): ?Livre
    + findAll(): array
    + search(string $keyword): array
    + save(Livre $livre): void
    + delete(string $id): void
  }
}

' Domaine des exemplaires physiques ou numériques
namespace App\Domain\Exemplaire {
  enum StatutExemplaire {
    DISPONIBLE
    EMPRUNTE
    PERDU
  }
  class Exemplaire {
    - string $id
    - string $codeBarre
    - StatutExemplaire $statut
    + __construct(string $codeBarre, StatutExemplaire $statut = DISPONIBLE)
    + getId(): string
    + getCodeBarre(): string
    + getStatut(): StatutExemplaire
    + emprunter(): void
    + retourner(): void
    + estDisponible(): bool
  }
  ' Interface de persistence pour Exemplaire
  interface ExemplaireRepositoryInterface {
    + findById(string $id): ?Exemplaire
    + findByLivre(string $livreId): array
    + findDisponiblesByLivre(string $livreId): array
    + save(Exemplaire $exemplaire): void
  }
}

' Domaine des emprunts et de leur cycle de vie
namespace App\Domain\Emprunt {
  enum StatutEmprunt {
    EN_COURS
    RENDU
    EN_RETARD
  }
  class Emprunt {
    - string $id
    - DateTime $dateEmprunt
    - DateTime $dateRetourPrevue
    - ?DateTime $dateRetourEffective
    - StatutEmprunt $statut
    + __construct(DateTime $dateEmprunt, DateTime $dateRetourPrevue)
    + getId(): string
    + getDateEmprunt(): DateTime
    + getDateRetourPrevue(): DateTime
    + getDateRetourEffective(): ?DateTime
    + getStatut(): StatutEmprunt
    + cloturer(DateTime $dateRetour): void
    + estEnRetard(): bool
  }
  ' Interface de persistence pour Emprunt
  interface EmpruntRepositoryInterface {
    + findById(string $id): ?Emprunt
    + findEnCoursByLecteur(string $lecteurId): array
    + findAll(): array
    + save(Emprunt $emprunt): void
  }
}

' Domaine des lecteurs de la bibliothèque
namespace App\Domain\Lecteur {
  class Lecteur {
    - string $id
    - string $nom
    - string $prenom
    - string $email
    - DateTime $dateAdhesion
    + __construct(string $nom, string $prenom, string $email, DateTime $dateAdhesion)
    + getId(): string
    + getNom(): string
    + getPrenom(): string
    + getEmail(): string
    + getDateAdhesion(): DateTime
  }
  ' Interface de persistence pour Lecteur
  interface LecteurRepositoryInterface {
    + findById(string $id): ?Lecteur
    + save(Lecteur $lecteur): void
  }
}

' Domaine des bibliothécaires et de leur gestion
namespace App\Domain\Bibliothecaire {
  class Bibliothecaire {
    - string $id
    - string $nom
    - string $prenom
    - string $email
    + __construct(string $nom, string $prenom, string $email)
    + getId(): string
    + getNom(): string
    + getPrenom(): string
    + getEmail(): string
  }
  ' Interface de persistence pour Bibliothecaire
  interface BibliothecaireRepositoryInterface {
    + findById(string $id): ?Bibliothecaire
    + save(Bibliothecaire $bibliothecaire): void
  }
}

' Services de domaine qui orchestrent la disponibilité et l'emprunt
namespace App\Domain\Services {
  class ServiceDisponibilite {
    + verifierDisponibilite(string $livreId): bool
    + obtenirExemplaireDisponible(string $livreId): ?Exemplaire
  }
  class ServiceGestionEmprunt {
    + enregistrerEmprunt(Lecteur $lecteur, Exemplaire $exemplaire): Emprunt
    + enregistrerRetour(Emprunt $emprunt): void
    + calculerRetard(Emprunt $emprunt): int
  }
}
@enduml